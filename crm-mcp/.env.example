# CRM MCP server config.
# These same variable names are used by the parent CRM project's .env,
# so the parent .env is automatically picked up if no local .env exists.

# Salesforce connection
SALESFORCE_USERNAME=your.email@example.com
SALESFORCE_PASSWORD=your-password
SALESFORCE_SECURITY_TOKEN=your-security-token
SALESFORCE_DOMAIN=login

# MCP transport (overrides only — defaults are stdio for dev safety)
CRM_MCP_TRANSPORT=stdio
CRM_MCP_HOST=127.0.0.1
CRM_MCP_PORT=7001

# Production deploy (docker compose sets these via `environment:` in docker-compose.yml,
# overriding the dev defaults above):
#   CRM_MCP_TRANSPORT=streamable-http
#   CRM_MCP_HOST=0.0.0.0
#   CRM_MCP_PORT=7001
