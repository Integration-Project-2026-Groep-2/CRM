<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kassa → CRM producer user contracts (C36-C38).
  Standalone schema for the producer payloads. Geen targetNamespace.

  Mixed-naming intentional: C36/C37 gebruiken <KassaUser*> om collision met
  Facturatie's <UserCreated>/<UserUpdated> (master schema, C24/C25) te vermijden.
  C38 hergebruikt <UserDeactivated> uit master schema (gedeeld met C22 outbound
  + C26 Facturatie inbound); deze file blijft daarom standalone — een
  <xs:include> in crm-schema-v1.xsd zou een duplicate-element compile-error
  geven op <UserDeactivated>.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="unqualified">

  <xs:include schemaLocation="../common-types.xsd"/>

  <!-- ============================================================
       CONTRACT 36 — Kassa → CRM: user aanmaken
       Queue: crm.kassa.user.created (routing key: kassa.user.created) | durable: true
  ============================================================ -->
  <xs:element name="KassaUserCreated">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="userId"    type="UUIDType"/>
        <xs:element name="firstName"  type="NameType"/>
        <xs:element name="lastName"   type="NameType"/>
        <xs:element name="email"      type="EmailType"/>
        <xs:element name="companyId"  type="UUIDType" minOccurs="0"/>
        <xs:element name="badgeCode"  type="NonEmptyStringType"/>
        <xs:element name="role"       type="UserRoleType"/>
        <xs:element name="createdAt"  type="ISO8601DateTimeType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ============================================================
       CONTRACT 37 — Kassa → CRM: user bijwerken
       Queue: crm.kassa.user.updated (routing key: kassa.user.updated) | durable: true
  ============================================================ -->
  <xs:element name="KassaUserUpdated">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="userId"    type="UUIDType"/>
        <xs:element name="firstName"  type="NameType"/>
        <xs:element name="lastName"   type="NameType"/>
        <xs:element name="email"      type="EmailType"/>
        <xs:element name="companyId"  type="UUIDType" minOccurs="0"/>
        <xs:element name="badgeCode"  type="NonEmptyStringType"/>
        <xs:element name="role"       type="UserRoleType"/>
        <xs:element name="updatedAt"  type="ISO8601DateTimeType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ============================================================
       CONTRACT 38 — Kassa → CRM: user deactiveren
       Queue: crm.kassa.user.deactivated (routing key: kassa.user.deactivated) | durable: true
  ============================================================ -->
  <xs:element name="UserDeactivated">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id"           type="UUIDType"/>
        <xs:element name="email"        type="EmailType"/>
        <xs:element name="deactivatedAt" type="ISO8601DateTimeType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
