# RabbitMQ (gebruik "rabbitmq" voor docker compose, "localhost" voor buiten Docker)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# E2E tests: zet op 1 als pytest zelf de lokale docker compose stack moet starten
# E2E_AUTO_START_LOCAL_STACK=1

# Salesforce (zie clickup)
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=login

# Optioneel
HEARTBEAT_INTERVAL_SECONDS=1
SYSTEM_NAME=CRM
STATUS_CHECK_INTERVAL_SECONDS=30
POLLING_INTERVAL_SECONDS=60
POLLING_STATE_PATH=/tmp/polling_checkpoint.json
# Override voor LastModifiedById-filter. Zet op een geldige-maar-niet-bestaande SF User Id
# (bv. 005000000000000AAA — prefix 005 = User object, checksum AAA = impossible ID)
# om alle writes door polling te laten doorkomen — nodig voor E2E tests en voor
# dev/sandbox waar admin == integration user. SF valideert ID-format dus willekeurige
# strings werken niet. Laat leeg in productie (polling doet zelf SOQL-lookup).
# POLLING_INTEGRATION_USER_ID=
LOG_LEVEL=INFO
