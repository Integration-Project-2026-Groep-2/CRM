# RabbitMQ (gebruik "rabbitmq" voor docker compose, "localhost" voor buiten Docker)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# E2E tests: zet op 1 als pytest zelf de lokale docker compose stack moet starten
# E2E_AUTO_START_LOCAL_STACK=1

# Salesforce (zie clickup)
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=login

# Optioneel
HEARTBEAT_INTERVAL_SECONDS=1
SYSTEM_NAME=CRM
STATUS_CHECK_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
